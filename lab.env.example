# Copy this file to lab.env and fill in real values. lab.env is gitignored --
# keep site-specific settings and secrets there, never in a tracked file.
#
# This file documents only what se-lab itself reads. Your product lab's own
# lab.env.example documents its <ENV_PREFIX>_* variables (repo URL, GHCR
# image, runtime dir, lab role) on top of this -- se-lab can't know that
# prefix in advance; it's set once by your product lab's scripts/agent.py via
# agent.runtime.configure(product_name=..., env_prefix=...), not through
# lab.env. Combine both files' contents into your actual lab.env.

# --- AI analysis (optional) -------------------------------------------------
# Used by `lab doctor ai`, `lab eval ai`, and post-failure analysis. A passing
# test run never calls AI.

# LiteLLM hub endpoint -- all AI traffic routes through this single proxy.
# LAB_LITELLM_URL=http://your-litellm-host:4000/v1

# Increase this if the first call has to load a model (default: 90).
# LAB_LITELLM_READ_TIMEOUT_SEC=90

# API key for the LiteLLM hub. Keep this in lab.env, never in shell environment
# history or a tracked file.
# LITELLM_KEY=replace-with-your-litellm-key

# Per-alias model overrides -- swap models without touching config/agent.yaml.
# Every alias defaults to empty; an unconfigured alias is skipped at routing
# time with an error naming it, not a silent fallback to someone else's model.
# LAB_MODEL_FAST=your-host/phi4-mini:latest
# LAB_MODEL_LIGHT=your-host/qwen3.5:9b
# LAB_MODEL_STANDARD=your-host/phi4:14b
# LAB_MODEL_CODER=your-host/qwen3-coder:30b
# LAB_MODEL_REASONER=your-host/deepseek-r1:14b
# LAB_MODEL_LARGE=your-host/qwen3.6:35b
# LAB_MODEL_AGENT=your-host/devstral-small:latest
# LAB_MODEL_CLOUD_FAST=your-host/deepseek-v4-flash:cloud
# LAB_MODEL_CLOUD_STANDARD=your-host/gemma4:31b-cloud
# LAB_MODEL_CLOUD_HEAVY=your-host/qwen3-coder-next:cloud
# LAB_MODEL_CLOUD_AGENT=your-host/minimax-m2.7:cloud
# LAB_MODEL_CLOUD_PREMIUM=your-host/your-premium-model:cloud

# --- Results / artifacts (optional) -----------------------------------------
# Override where run results and ad-hoc test artifacts land. Unset defaults
# to a runtime-dir-relative path under the lab's runtime directory.
# LAB_RESULTS_DIR=/opt/lab/results
# LAB_ARTIFACTS_DIR=/opt/lab/artifacts

# Set by test scripts that want a live per-test progress event log (JSON
# lines) as a RunContext runs, e.g. for a dashboard tailing the file. Leave
# unset for scripts that only need the final summary.
# LAB_PROGRESS_FILE=/tmp/lab-progress.jsonl
